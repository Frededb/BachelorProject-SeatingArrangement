#!/bin/bash

#SBATCH --job-name=timeArrangements        # Job name
#SBATCH --output=job%A/%a.out   # Name of output file (%A=jobId, %a=arrayId)
#SBATCH --cpus-per-task=8        # Schedule one core
#SBATCH --time=24:00:00          # Run time (hh:mm:ss)
#SBATCH --mem=32G
#SBATCH --partition=scavenge
#SBATCH --array=0-9             # One task per algorithm
# #SBATCH --gres=gpu:rtx2070:1 
# #SBATCH --constraint="desktop"
# #SBATCH --mail-type=BEGIN,FAIL,END

# Map array task ID to algorithm name
ALGOS=(
    "annealingFromFluent"
    "annealingFromRandom"
    "linearSwitchFromFluent"
    "linearSwitchFromFluentv4"
    "linearSwitchFromFluentProtected"
    "linearSwitchFromRandom"
    "linearSwitchFromRandomv4"
    "randomSwitchFromFluent"
    "randomSwitchFromRandom"
    "tabuSearchFromFluent"
    "tabuSearchFromRandom"
    "bruteForce"
    "theoreticalMax"
)

ALGO=${ALGOS[9]}
echo "Task $SLURM_ARRAY_TASK_ID running algorithm: $ALGO"

# Print out the hostname of the node the job is running on
hostname
whoami
echo $PWD

srun apptainer run container34.sif --output "job${SLURM_ARRAY_JOB_ID}/${SLURM_ARRAY_TASK_ID}-$(hostname)" --algo "$ALGO"
