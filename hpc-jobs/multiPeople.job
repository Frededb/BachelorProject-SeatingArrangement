#!/bin/bash

#SBATCH --job-name=manyTime        # Job name
#SBATCH --output=job%A/%a.out   # Name of output file (%A=jobId, %a=arrayId)
#SBATCH --cpus-per-task=4        # Schedule one core
#SBATCH --time=24:00:00          # Run time (hh:mm:ss)
#SBATCH --mem=8G
#SBATCH --partition=scavenge
#SBATCH --array=0-23            # One task per algorithm+people_count combination
#SBATCH --mail-type=BEGIN,FAIL,END

# Map array task ID to algorithm + people count
ALGOS=(
    "annealingFromGrouped"
    "annealingFromRandom"
    # "linearSwitchFromGrouped"
    # "linearSwitchFromGroupedProtected"
    # "linearSwitchFromRandom"
    "randomSwitchFromGrouped"
    "randomSwitchFromRandom"
    "tabuSearchFromGrouped"
    "tabuSearchFromRandom"


    # "bruteForce"
    # "theoreticalMax"
    # "theoreticalMaxTable"
)

PEOPLE_COUNTS=(8 30 100 300)

N_PEOPLE=${#PEOPLE_COUNTS[@]}
ALGO_IDX=$((SLURM_ARRAY_TASK_ID / N_PEOPLE))
PEOPLE_IDX=$((SLURM_ARRAY_TASK_ID % N_PEOPLE))

ALGO=${ALGOS[$ALGO_IDX]}
PEOPLE=${PEOPLE_COUNTS[$PEOPLE_IDX]}
echo "Task $SLURM_ARRAY_TASK_ID running algorithm: $ALGO, people: $PEOPLE"

# Print out the hostname of the node the job is running on
hostname
whoami
echo $PWD

srun apptainer run container.sif --output "job${SLURM_ARRAY_JOB_ID}" --algo "$ALGO" --people "$PEOPLE"
